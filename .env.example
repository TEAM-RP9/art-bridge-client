# Server-only. Used by next.config.ts rewrites to proxy /api/* to the backend.
# Never sent to the browser bundle. Defaults to http://localhost:8080 in dev.
BACKEND_API_URL=http://localhost:8080

# Browser-visible base for the API client. Should stay as "/api" so requests
# go through the Next.js rewrite (same-origin → SameSite=Strict cookies work).
NEXT_PUBLIC_API_BASE_URL=/api
